<mujoco model="so101_top_grasp_scene">
  <include file="so_arm101.xml" />

  <statistic center="0.20 0 0.25" extent="0.8" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <global azimuth="150" elevation="-25" />
  </visual>

  <asset>
    <material name="floor_mat" rgba="0.2 0.2 0.2 1" />
    <material name="table_mat" rgba="0.55 0.55 0.55 1" />
    <material name="target_box_mat" rgba="0.2 0.45 0.85 1" />
  </asset>

  <worldbody>
    <light name="key_light" pos="0 -0.5 1.0" dir="0 0 -1" />
    <geom name="floor" type="plane" size="1.0 1.0 0.01" material="floor_mat" />

    <body name="table" pos="0.25 0 0.025">
      <geom name="table_top" type="box" size="0.35 0.25 0.025" material="table_mat" />
      <site name="table_top_center" pos="0 0 0.025" size="0.01" rgba="0 1 0 1" />
    </body>

    <!--
      Precision-placement target visualization.

      Frozen benchmark region:
        center = (0.280, 0.000) m
        size   = 0.060 x 0.060 m

      These four geoms are visual-only:
        contype=0, conaffinity=0
      so they do not participate in contact physics.
    -->
    <geom
      name="precision_target_x_min"
      type="box"
      pos="0.250 0.000 0.05030"
      size="0.002 0.030 0.00025"
      rgba="1.0 0.9 0.0 1"
      contype="0"
      conaffinity="0"
    />
    <geom
      name="precision_target_x_max"
      type="box"
      pos="0.310 0.000 0.05030"
      size="0.002 0.030 0.00025"
      rgba="1.0 0.9 0.0 1"
      contype="0"
      conaffinity="0"
    />
    <geom
      name="precision_target_y_min"
      type="box"
      pos="0.280 -0.030 0.05030"
      size="0.030 0.002 0.00025"
      rgba="1.0 0.9 0.0 1"
      contype="0"
      conaffinity="0"
    />
    <geom
      name="precision_target_y_max"
      type="box"
      pos="0.280 0.030 0.05030"
      size="0.030 0.002 0.00025"
      rgba="1.0 0.9 0.0 1"
      contype="0"
      conaffinity="0"
    />

    <body name="target_box" pos="0.24 0 0.065">
      <freejoint name="target_box_freejoint" />
      <geom name="target_box_geom" type="box" size="0.025 0.025 0.015" mass="0.03" material="target_box_mat" />
      <site name="target_box_center" pos="0 0 0" size="0.01" rgba="1 0 0 1" />
    </body>

    <camera name="top" pos="0.25 0 0.75" xyaxes="1 0 0 0 1 0" />
  </worldbody>
</mujoco>
